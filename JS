function mostraPergunta() {

if (atual >= perguntas.length) {
    mostraResultado();
    return;
}

const perguntaAtual = perguntas[atual];

caixaPerguntas.textContent = perguntaAtual.enunciado;

caixaAlternativas.innerHTML = "";

numeroPergunta.textContent =
    `${atual + 1} / ${perguntas.length}`;

const progresso =
    ((atual + 1) / perguntas.length) * 100;

barraProgresso.style.width =
    `${progresso}%`;

mostraAlternativas();


}

function mostraAlternativas() {

const perguntaAtual = perguntas[atual];

for (const alternativa of perguntaAtual.alternativas) {

    const botao =
        document.createElement("button");

    botao.textContent =
        alternativa.texto;

    botao.addEventListener(
        "click",
        () => respostaSelecionada(alternativa)
    );

    caixaAlternativas.appendChild(botao);
}


}

function respostaSelecionada(opcaoSelecionada) {

pontuacao += opcaoSelecionada.pontos || 0;

tecnologia += opcaoSelecionada.tecnologia || 0;

etica += opcaoSelecionada.etica || 0;

criatividade += opcaoSelecionada.criatividade || 0;

atual++;

mostraPergunta();


}

function mostraResultado() {

document.querySelector(".caixa-jogo").style.display = "none";

caixaResultado.style.display = "block";

barraProgresso.style.width = "100%";

numeroPergunta.textContent =
    "Concluído";

const resultado =
    descobrirPerfil();

perfilFinal.textContent =
    resultado.nome;

pontuacaoFinal.textContent =
    pontuacao;

textoResultado.innerHTML =
    resultado.texto;


}

function descobrirPerfil() {

/*
    A ideia aqui não é dizer que existe
    uma escolha "certa".

    O resultado apenas representa
    o conjunto de escolhas realizadas.
*/

if (
    etica >= tecnologia &&
    etica >= criatividade
) {

    return {

        nome: "GUARDIÃO",

        texto:
            "Você imaginou um futuro em que o desenvolvimento da IA precisa caminhar junto com responsabilidade, transparência e participação humana. Para você, a tecnologia pode trazer grandes benefícios, mas as pessoas precisam continuar discutindo seus impactos e estabelecendo limites."
    };
}


if (
    tecnologia > etica &&
    tecnologia >= criatividade
) {

    return {

        nome: "PIONEIRO",

        texto:
            "Seu futuro é marcado pela exploração das possibilidades da Inteligência Artificial. Você vê a tecnologia como uma ferramenta capaz de transformar a maneira como aprendemos, trabalhamos e resolvemos problemas. Nesse cenário, experimentar e descobrir novas possibilidades tem um papel importante."
    };
}


if (
    criatividade > tecnologia &&
    criatividade > etica
) {

    return {

        nome: "CRIADOR",

        texto:
            "Você imagina um futuro em que a IA amplia a criatividade humana. Em vez de substituir a imaginação das pessoas, a tecnologia aparece como uma ferramenta para experimentar novas ideias, criar projetos e explorar possibilidades que antes seriam difíceis de alcançar."
    };
}


return {

    nome: "EQUILIBRISTA",

    texto:
        "Suas escolhas mostram uma tentativa de equilibrar diferentes possibilidades. Você reconhece o potencial da IA, mas também considera seus impactos sociais, éticos e criativos. Seu futuro combina inovação, responsabilidade e participação humana."
};


}

function reiniciarJogo() {

atual = 0;

pontuacao = 0;

tecnologia = 0;

etica = 0;

criatividade = 0;

caixaResultado.style.display = "none";

document.querySelector(".caixa-jogo").style.display =
    "block";

mostraPergunta();


}

