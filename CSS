:root {
--cor-fundo: #01080e;
--cor-principal: #0b0d20;
--cor-secundaria: #15182d;
--cor-borda: #252945;

--cor-destaque: #2bdefd;
--cor-destaque-secundaria: #7c4dff;

--cor-texto: #d7f9ff;
--cor-texto-secundario: #9ba8b5;

--verde: #39ff88;
--vermelho: #ff5577;


}

{
margin: 0;
padding: 0;
box-sizing: border-box;
}

body {
background:
radial-gradient(
circle at top,
rgba(43, 222, 253, 0.12),
transparent 35%
),
var(--cor-fundo);

color: var(--cor-texto);

font-family:
    Arial,
    Helvetica,
    sans-serif;

min-height: 100vh;

display: flex;
justify-content: center;
align-items: center;

padding: 30px 15px;


}

body::before {
content: "";

position: fixed;

width: 300px;
height: 300px;

background: var(--cor-destaque);

filter: blur(180px);

opacity: 0.08;

top: 10%;
left: 10%;

pointer-events: none;


}

.caixa-principal {
width: 100%;
max-width: 720px;

background: rgba(11, 13, 32, 0.95);

border: 1px solid var(--cor-borda);

border-radius: 24px;

padding: 35px;

box-shadow:
    0 0 40px rgba(43, 222, 253, 0.08),
    0 20px 60px rgba(0, 0, 0, 0.4);

position: relative;

overflow: hidden;


}

/* CABEÇALHO */

.cabecalho {
text-align: center;

margin-bottom: 30px;


}

.tag {
display: inline-block;

color: var(--cor-destaque);

border: 1px solid rgba(43, 222, 253, 0.4);

background: rgba(43, 222, 253, 0.06);

padding: 7px 14px;

border-radius: 20px;

font-size: 11px;

font-weight: bold;

letter-spacing: 2px;

margin-bottom: 15px;


}

h1 {
color: var(--cor-destaque);

font-size: 38px;

margin-bottom: 12px;

text-shadow:
    0 0 15px rgba(43, 222, 253, 0.4);


}

.subtitulo {
color: var(--cor-texto-secundario);

font-size: 15px;

line-height: 1.6;

max-width: 570px;

margin: auto;


}

/* PROGRESSO */

.progresso-container {
margin-top: 25px;

text-align: left;


}

.progresso-info {
display: flex;

justify-content: space-between;

color: var(--cor-texto-secundario);

font-size: 12px;

margin-bottom: 8px;


}

.barra {
width: 100%;

height: 7px;

background: #080a15;

border-radius: 20px;

overflow: hidden;


}

.barra-progresso {
width: 10%;

height: 100%;

background:
    linear-gradient(
        90deg,
        var(--cor-destaque),
        var(--cor-destaque-secundaria)
    );

border-radius: 20px;

transition: width 0.5s ease;


}

/* JOGO */

.caixa-jogo {
animation: aparecer 0.5s ease;
}

.icone-pergunta {
width: 55px;
height: 55px;

display: flex;

justify-content: center;
align-items: center;

background:
    linear-gradient(
        135deg,
        rgba(43, 222, 253, 0.15),
        rgba(124, 77, 255, 0.15)
    );

border: 1px solid rgba(43, 222, 253, 0.3);

border-radius: 15px;

font-size: 25px;

margin-bottom: 20px;


}

.caixa-perguntas {
font-size: 20px;

font-weight: bold;

line-height: 1.6;

margin-bottom: 25px;


}

.caixa-alternativas {
display: flex;

flex-direction: column;

gap: 12px;


}

.caixa-alternativas button {
width: 100%;

text-align: left;

padding: 18px 20px;

background: var(--cor-secundaria);

color: var(--cor-texto);

border: 1px solid var(--cor-borda);

border-radius: 14px;

cursor: pointer;

font-size: 15px;

line-height: 1.5;

transition:
    transform 0.2s,
    background 0.2s,
    border 0.2s,
    box-shadow 0.2s;


}

.caixa-alternativas button:hover {
transform: translateY(-3px);

background: rgba(43, 222, 253, 0.1);

border-color: var(--cor-destaque);

box-shadow:
    0 5px 20px rgba(43, 222, 253, 0.1);


}

.caixa-alternativas button:active {
transform: scale(0.98);
}

/* RESULTADO */

.caixa-resultado {
display: none;

text-align: center;

animation: aparecer 0.7s ease;


}

.resultado-icone {
font-size: 55px;

margin-bottom: 15px;


}

.caixa-resultado h2 {
color: var(--cor-destaque);

font-size: 32px;

margin-bottom: 20px;


}

.texto-resultado {
color: var(--cor-texto);

font-size: 17px;

line-height: 1.8;

margin-bottom: 25px;


}

/* ESTATÍSTICAS */

.estatisticas {
display: flex;

justify-content: center;

gap: 20px;

margin-bottom: 25px;


}

.estatistica {
min-width: 130px;

padding: 18px;

background: var(--cor-secundaria);

border: 1px solid var(--cor-borda);

border-radius: 15px;


}

.numero {
display: block;

color: var(--cor-destaque);

font-size: 25px;

font-weight: bold;

margin-bottom: 5px;


}

.descricao {
color: var(--cor-texto-secundario);

font-size: 12px;


}

/* BOTÃO REINICIAR */

.botao-reiniciar {
border: none;

background:
    linear-gradient(
        90deg,
        var(--cor-destaque),
        var(--cor-destaque-secundaria)
    );

color: #02060a;

font-weight: bold;

font-size: 15px;

padding: 15px 25px;

border-radius: 12px;

cursor: pointer;

transition:
    transform 0.2s,
    box-shadow 0.2s;


}

.botao-reiniciar:hover {
transform: translateY(-3px);

box-shadow:
    0 8px 25px rgba(43, 222, 253, 0.2);


}

/* RODAPÉ */

footer {
text-align: center;

margin-top: 30px;

color: #596471;

font-size: 11px;


}

/* ANIMAÇÃO */

@keyframes aparecer {
from {
opacity: 0;

    transform: translateY(15px);
}

to {
    opacity: 1;

    transform: translateY(0);
}


}

/* CELULAR */

@media (max-width: 600px) {

body {
    padding: 15px;
}

.caixa-principal {
    padding: 25px 20px;

    border-radius: 18px;
}

h1 {
    font-size: 29px;
}

.subtitulo {
    font-size: 14px;
}

.caixa-perguntas {
    font-size: 18px;
}

.caixa-alternativas button {
    font-size: 14px;

    padding: 16px;
}

.estatisticas {
    gap: 10px;
}

.estatistica {
    min-width: 110px;
}


}
